# =====================================================================
# KVI AI School Intelligence Agent — environment configuration
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# All values below are PLACEHOLDERS only.
# =====================================================================

# --- Core application -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KVI_SECRET_KEY=CHANGE_ME_random_secret_key
KVI_ENV=development
# SQLite for local development; for production use PostgreSQL, e.g.
# KVI_DATABASE_URL=postgresql+psycopg2://kvi:CHANGE_ME@localhost:5432/kvi_intel
KVI_DATABASE_URL=sqlite:///./data/kvi.db

# --- School profile (defaults in app/config.py match the school) -------
KVI_SCHOOL_NAME=Kashyap Vidyapeeth Inaruwa
KVI_REPORT_RECIPIENT=kptcc@gmail.com
# Backup recipient — email backup delivery stays DISABLED until this is set
KVI_BACKUP_RECIPIENT=
KVI_PUBLIC_DASHBOARD_URL=

# --- Scheduler ---------------------------------------------------------
KVI_REPORT_HOUR=19
KVI_REPORT_MINUTE=0
KVI_TIMEZONE=Asia/Kathmandu
KVI_SCHEDULER_ENABLED=true
# Watch-folder scan interval in minutes (WhatsApp export drop folder)
KVI_IMPORT_WATCH_INTERVAL_MIN=15
KVI_IMPORT_WATCH_DIR=./data/imports

# --- Email (SMTP or transactional provider SMTP relay) ------------------
# Leave host empty to disable sending (reports still generated & archived).
KVI_SMTP_HOST=
KVI_SMTP_PORT=587
KVI_SMTP_STARTTLS=true
KVI_SMTP_SSL=false
KVI_SMTP_USERNAME=
KVI_SMTP_PASSWORD=
KVI_SMTP_FROM=KVI School Intelligence <no-reply@kvnepal.edu.np>
KVI_EMAIL_MAX_RETRIES=4
KVI_EMAIL_BACKOFF_BASE_SECONDS=2
KVI_EMAIL_ATTACH_PDF=true
# Optional Devanagari-capable TTF for Nepali text inside the PDF (e.g. Noto Sans Devanagari)
KVI_PDF_FONT_PATH=

# --- Meta (Facebook Page) integration -----------------------------------
# Create an app at https://developers.facebook.com — see docs/META_FACEBOOK_SETUP.md
# Permissions: pages_read_engagement, pages_show_list, read_insights
KVI_FB_PAGE_ID=
KVI_FB_PAGE_URL=
KVI_FB_ACCESS_TOKEN=
KVI_FB_API_VERSION=v21.0

# --- AI analysis provider (OPTIONAL) --------------------------------------
# Any OpenAI-compatible chat completions endpoint. When unset, the built-in
# deterministic rules engine performs classification/priority/summarization
# and the report is labelled "rules engine" (never silently mocked).
KVI_AI_API_BASE=
KVI_AI_API_KEY=
KVI_AI_MODEL=
KVI_AI_ENABLED=true

# --- Privacy & retention ---------------------------------------------------
KVI_RETENTION_DAYS=365
KVI_REDACT_IN_SUMMARIES=true

# --- Bootstrap admin (used only on first run to create the admin user) ------
KVI_ADMIN_USERNAME=admin
KVI_ADMIN_PASSWORD=CHANGE_ME_strong_password
